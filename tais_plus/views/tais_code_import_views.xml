<odoo>
    <record id="taiscode_import_form" model="ir.ui.view">
        <field name="name">tais_plus.taiscode.import.form</field>
        <field name="model">tais_plus.taiscode.import</field>
        <field name="arch" type="xml">
            <form string="TAISコード取得（最新化）">
                <group>
                    <field name="tais_codes" widget="text"/>
                </group>
                <footer>
                    <button string="実行" type="object" name="import_tais_codes" class="btn-primary"/>
                    <button string="閉じる" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- アクション -->
    <record id="taiscode_import_act_window" model="ir.actions.act_window">
        <field name="name">TAISコード取得（最新化）</field>
        <field name="res_model">tais_plus.taiscode.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
